{
  "name": "mlmorph",
  "build": {
    "dockerfile": "Dockerfile"
  },
  // Build the automata, then install the python package editable with dev deps.
  // setuptools-scm derives the version from git tags (present in the mount).
  "postCreateCommand": "make all",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "rust-lang.rust-analyzer"
      ],
      "settings": {
        "python.testing.pytestEnabled": true
      }
    }
  }
}
